#!/usr/bin/env bash
# go-budget — cuánto llevas gastado de la BOLSA COMPARTIDA del plan OpenCode Go.
#
# Desde la doc del 2026-11-20 (opencode.ai/docs/go) el plan vuelve a tener UNA sola bolsa:
#     "The paid models you use on Go share one allowance. […] Switching models draws from the
#      same allowance."
# Lo que cambia por modelo es CUÁNTO PESA cada dólar: el "límite mensual" de un modelo es lo que
# la bolsa cubre si usas SOLO ese modelo todo el mes. La doc: "$1.50 of usage on a model with a
# $15 limit uses 10% of your monthly allowance. So does $6 on a model with a $60 limit."
#     consumo de la bolsa = Σ (dólares gastados en el modelo / límite mensual del modelo)
# y las tres ventanas son fracciones de esa bolsa:
#     5 horas = 20% (corre desde el primer uso) · semana = 50% (se reinicia el LUNES 00:00 UTC)
#     mes = 100% (se reinicia al iniciar el periodo de pago)
# Consecuencia: agotar la bolsa bloquea TODOS los modelos de pago; cambiar de modelo ya NO
# consigue presupuesto, solo cambia qué tan rápido lo gastas. Quedan fuera de la bolsa los
# gratuitos (`hy4-flash-free`, `beam-free`, …) y, por otra puerta, `codex:*`.
#
# Uso:
#   go-budget                 # la bolsa en sus tres ventanas + cuánto aporta cada modelo
#   go-budget --model <id>    # además dice cuánto pesa 1 USD de ESE modelo
#   go-budget --tsv           # ventana<TAB>USD gastados<TAB>bolsa<TAB>% de la ventana
#                             # y model:<id><TAB>gasto30d<TAB>límite<TAB>puntos30d<TAB>puntos7d<TAB>puntos5h
#                             # (puntos = puntos porcentuales de la ventana que aporta ese modelo)
#   go-budget --quiet         # sin salida; solo el exit code
#
# Exit code:  0 = holgado (<80% de la bolsa en las tres ventanas)
#             1 = apretado (≥80% en alguna ventana)
#             2 = agotado (≥100% en alguna ventana): ningún modelo de pago va a responder
#             3 = no se pudo medir (falta opencode o la base)
#
# De dónde salen los límites: del endpoint público `https://opencode.ai/inference/go/v1/models`
# (campo `go.monthly_usage`), con caché de 24 h en ~/.cache/cheap-fanout/. Así una promoción
# (p. ej. GLM-5.3 a 500 USD hasta el 2026-11-22) se refleja sola. Sin red, sin `jq` o con
# GO_BUDGET_OFFLINE=1 usa la tabla de respaldo de abajo (leída el 2026-11-20).
# GO_PLUS=1 y GO_TEAMS=1 eligen la columna de ese plan.
#
# LÍMITES DE ESTA MEDICIÓN (léelos antes de confiar en el número):
#   - Sale de la base local de sesiones de opencode (`opencode db`), así que solo cuenta lo
#     gastado DESDE ESTA MÁQUINA. Si usas el plan desde otro lado, subestima.
#   - El `cost` lo calcula opencode con su propia tabla de precios; es su estimación, no la
#     factura del proveedor. En DeepSeek hay precio peak/off-peak: si el lote corrió en peak,
#     la estimación puede quedarse corta.
#   - Un job cortado por plazo (124/137) lo cobra el proveedor, pero opencode no anota el costo
#     del paso que estaba en curso: con timeouts en modelos caros, el gasto real es mayor.
#   - Todo el gasto se pondera con el límite de HOY: si un límite cambió a mitad del mes, lo
#     gastado antes queda mal ponderado.
#   - La ventana de 5h se toma como las últimas 5 horas corridas y la semana desde el lunes
#     00:00 UTC (como dice la doc). El mes se toma como los últimos 30 días corridos porque el
#     script no conoce tu fecha de cobro: sobreestima justo después de renovar. Si la sabes,
#     pásala con GO_PERIOD_DAY=<día del mes en que renueva>. La cifra autoritativa es la consola.
#   - Un modelo sin límite conocido sale con "?" y NO suma a la bolsa (subestima).
#   - El esquema de bolsa sale del TEXTO de la doc y no está contrastado con la consola: el
#     2026-11-06 su barra cuadraba con el modelo más cargado, no con la suma ponderada. Si la
#     consola y este script no cuadran, manda la consola.
set -uo pipefail
# printf/awk deben usar punto decimal: con locale es_MX, "%.4f" rechaza "0.0443".
export LC_NUMERIC=C

MODE="table"
WANT_MODEL=""
while [ $# -gt 0 ]; do
  case "$1" in
    --tsv)   MODE="tsv"; shift;;
    --quiet) MODE="quiet"; shift;;
    --model) WANT_MODEL="${2:-}"; shift 2 || true
             [ -n "$WANT_MODEL" ] || { echo "go-budget: --model necesita un id" >&2; exit 3; };;
    -h|--help) awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; exit 0;;
    *) echo "go-budget: opción desconocida: $1" >&2; exit 3;;
  esac
done

command -v opencode >/dev/null 2>&1 || { echo "go-budget: opencode no está en PATH" >&2; exit 3; }

# Modelos vetados (ver SKILL.md). Aquí NO se ocultan: si aparecen con gasto es que algo se los
# saltó, y eso es justo lo que quieres ver.
VETADOS="muse-spark-1.2-contributor muse-spark-1.3-contributor iceman-contributor-free grok-4.6 grok-4.7"

# Tabla de respaldo: id · límite Go · Go Plus · Go Teams (USD/mes; 0 = gratuito, fuera de la
# bolsa). Endpoint leído el 2026-11-20. `glm-5.3` va con su límite normal (15/120/20): los 500
# de la promoción vencen el 2026-11-22 y el respaldo prefiere sobreestimar el consumo. Abajo de
# la línea en blanco, modelos ya retirados: se quedan para contabilizar lo gastado en el mes.
TOPES='
deepseek-v4.1-flash 100 200 105
deepseek-v4-pro 15 60 20
glm-5.3 15 120 20
glm-5.3-flash 60 180 65
gpt-6-luna 15 60 20
gpt-5.6-luna 15 60 20
claude-haiku-5-5 15 60 20
gemini-4-argon 30 120 35
hy4 60 240 65
hy4-preview 30 120 35
hy3 60 240 65
kimi-k3.1-pro 15 60 20
kimi-k3 15 60 20
kimi-k2.7-code 60 180 65
longcat-2.0 60 240 65
mimo-v2.6-flash 60 120 65
mimo-v2.6-pro 15 60 20
minimax-m3.1-flash 20 80 25
minimax-m3 60 180 65
qwen4-max 15 60 20
qwen3.8-max 15 60 20
qwen3.8-flash 30 90 35
qwen3.7-plus 60 180 65
step-5-preview 15 60 20
grok-4.7 15 60 20
muse-spark-1.3-contributor 60 120 65
muse-spark-1.2-contributor 60 120 65
beam-free 0 0 0
hy4-flash-free 0 0 0
longcat-2.5-free 0 0 0
iceman-contributor-free 0 0 0

glm-5.2 60 180 65
mimo-v2.5 60 120 65
mimo-v2.5-pro 15 60 20
deepseek-v4-flash 30 120 35
deepseek-v4-flash-vision-exp 15 60 20
minimax-m2.7 60 240 65
kimi-k2.6 60 240 65
grok-4.6 15 60 20
longcat-2.5-preview-free 0 0 0
space-bunny-free 0 0 0
step-5-preview-free 0 0 0
minimax-m2.5 60 180 65
qwen3.7-max 60 180 65
qwen3.6-plus 60 180 65
glm-5.1 60 180 65
grok-4.5 15 60 20
'

PLAN_COL=2; PLAN_NAME="Go"
[ "${GO_TEAMS:-0}" = 1 ] && { PLAN_COL=4; PLAN_NAME="Go Teams"; }
[ "${GO_PLUS:-0}" = 1 ]  && { PLAN_COL=3; PLAN_NAME="Go Plus"; }

# Límites en vivo (id go plus teams). Vacío si no hay red/jq o si se pidió sin conexión.
LIVE=""; LIM_SRC="tabla de respaldo (2026-11-20)"
if [ "${GO_BUDGET_OFFLINE:-0}" != 1 ] && command -v jq >/dev/null 2>&1; then
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/cheap-fanout"; cache="$cache_dir/go-models.json"
  fresh=0
  [ -s "$cache" ] && [ -n "$(find "$cache" -mmin -1440 2>/dev/null)" ] && fresh=1
  if [ "$fresh" = 0 ] && command -v curl >/dev/null 2>&1; then
    mkdir -p "$cache_dir" 2>/dev/null
    if curl -fsS -m 8 "${GO_MODELS_URL:-https://opencode.ai/inference/go/v1/models}" -o "$cache.tmp" 2>/dev/null \
       && jq -e '.data | length > 0' "$cache.tmp" >/dev/null 2>&1; then
      mv -f "$cache.tmp" "$cache"; fresh=1
    else
      rm -f "$cache.tmp"
    fi
  fi
  if [ -s "$cache" ]; then
    LIVE="$(jq -r '.data[] | [.id, (.go.monthly_usage.go // 0), (.go.monthly_usage["go-plus"] // 0),
            (.go.monthly_usage["go-teams"] // 0)] | @tsv' "$cache" 2>/dev/null | tr '\t' ' ')"
    if [ -n "$LIVE" ]; then
      [ "$fresh" = 1 ] && LIM_SRC="endpoint de Go" || LIM_SRC="endpoint de Go (caché vieja, sin red)"
    fi
  fi
fi
# El endpoint manda; la tabla de respaldo cubre los modelos que ya no sirve.
limit_of() { printf '%s\n%s\n' "$LIVE" "$TOPES" | awk -v m="$1" -v c="$PLAN_COL" '$1==m{print $c; exit}'; }

# Ventanas, en segundos hacia atrás desde ahora.
now="$(date -u +%s)"
dow="$(date -u +%u)"                                  # 1 = lunes
week_secs=$(( (dow - 1) * 86400 + now % 86400 ))      # desde el lunes 00:00 UTC
month_secs=2592000; MONTH_LABEL="30d corridos"
if [ -n "${GO_PERIOD_DAY:-}" ]; then
  case "$GO_PERIOD_DAY" in
    ''|*[!0-9]*) echo "go-budget: GO_PERIOD_DAY debe ser un día del mes (1-28)" >&2; exit 3;;
  esac
  if [ "$GO_PERIOD_DAY" -ge 1 ] && [ "$GO_PERIOD_DAY" -le 28 ]; then
    d="$(printf '%02d' "$GO_PERIOD_DAY")"
    start="$(date -u -d "$(date -u +%Y-%m)-$d 00:00:00" +%s 2>/dev/null || echo "")"
    if [ -n "$start" ] && [ "$start" -gt "$now" ]; then
      start="$(date -u -d "$(date -u -d "$(date -u +%Y-%m)-15 -1 month" +%Y-%m)-$d 00:00:00" +%s 2>/dev/null || echo "")"
    fi
    [ -n "$start" ] && { month_secs=$(( now - start )); MONTH_LABEL="desde el día $GO_PERIOD_DAY"; }
  else
    echo "go-budget: GO_PERIOD_DAY debe estar entre 1 y 28" >&2; exit 3
  fi
fi

# Gasto por modelo y ventana: modelID<TAB>ventana<TAB>gastado (solo las filas con gasto).
win_sql() { # $1 = etiqueta, $2 = segundos de la ventana
  printf 'SELECT json_extract(data,"$.modelID"), "%s", COALESCE(SUM(json_extract(data,"$.cost")),0) FROM message
 WHERE json_extract(data,"$.providerID")="opencode-go"
   AND json_extract(data,"$.time.created") >= (CAST(strftime("%%s","now") AS INTEGER)-%s)*1000
 GROUP BY 1' "$1" "$2"
}
sql="$(win_sql 5h 18000)
UNION ALL
$(win_sql 7d "$week_secs")
UNION ALL
$(win_sql 30d "$month_secs")"

raw="$(opencode db "$sql" --format tsv 2>/dev/null)"; rc=$?
if [ "$rc" != 0 ]; then
  [ "$MODE" = quiet ] || echo "go-budget: no pude leer la base de opencode" >&2
  exit 3
fi
raw="$(printf '%s\n' "$raw" | tail -n +2)"   # fuera la cabecera; vacío = sin gasto en el mes

bar() { local n=$(( ${1:-0} / 10 )) i=0 b=""; [ "$n" -gt 10 ] && n=10
        while [ "$i" -lt "$n" ]; do b="${b}█"; i=$((i+1)); done; printf '%s' "$b"; }

# Un renglón por modelo: id, gasto mes, gasto semana, gasto 5h.
models="$(printf '%s\n' "$raw" | awk -F'\t' 'NF>=3 && $1!="" && $1!="null"{m[$1]=1; g[$1,$2]=$3}
  END{for(k in m) printf "%s\t%.6f\t%.6f\t%.6f\n", k, g[k,"30d"]+0, g[k,"7d"]+0, g[k,"5h"]+0}')"

# Por modelo: puntos porcentuales que aporta a cada ventana de la bolsa.
#   mes = gasto/límite · semana = gasto/(límite×0.5) · 5h = gasto/(límite×0.2)
rows=""            # puntos30 \t id \t gasto30 \t límite \t p30 \t p7 \t p5   (con límite)
rows_other=""      # id \t gasto30 \t etiqueta                                 (libres y "?")
vetado_con_gasto=""; sin_limite=""
if [ -n "${models:-}" ]; then
  while IFS=$'\t' read -r mid s30 s7 s5; do
    [ -n "${mid:-}" ] || continue
    lim="$(limit_of "$mid")"
    case " $VETADOS " in
      *" $mid "*) awk -v g="${s30:-0}" 'BEGIN{exit !(g>0)}' && \
                  vetado_con_gasto="${vetado_con_gasto}${vetado_con_gasto:+, }${mid}";;
    esac
    if [ -z "$lim" ]; then
      rows_other="${rows_other}${mid}\t${s30}\t?\n"; sin_limite="${sin_limite}${sin_limite:+, }${mid}"; continue
    fi
    if [ "$lim" = 0 ]; then rows_other="${rows_other}${mid}\t${s30}\tlibre\n"; continue; fi
    rows="${rows}$(awk -v m="$mid" -v a="$s30" -v b="$s7" -v c="$s5" -v l="$lim" \
      'BEGIN{printf "%.4f\t%s\t%s\t%s\t%.2f\t%.2f\t%.2f", a*100/l, m, a, l, a*100/l, b*100/(l*0.5), c*100/(l*0.2)}')\n"
  done <<< "$models"
fi

sumcol() { printf "%b" "$rows" | awk -F'\t' -v c="$1" 'NF>=7{s+=$c} END{printf "%.1f", s+0}'; }
usd()    { printf '%s\n' "$raw" | awk -F'\t' -v w="$1" 'NF>=3 && $2==w{s+=$3} END{printf "%.4f", s+0}'; }
P30="$(sumcol 5)"; P7="$(sumcol 6)"; P5="$(sumcol 7)"
U30="$(usd 30d)";  U7="$(usd 7d)";   U5="$(usd 5h)"

worst="$(awk -v a="$P30" -v b="$P7" -v c="$P5" 'BEGIN{m=a; if(b>m)m=b; if(c>m)m=c; print (m>=100?2:(m>=80?1:0))}')"

case "$MODE" in
  quiet) ;;
  tsv)
    printf '5h\t%s\tbolsa\t%.0f\n7d\t%s\tbolsa\t%.0f\n30d\t%s\tbolsa\t%.0f\n' "$U5" "$P5" "$U7" "$P7" "$U30" "$P30"
    printf "%b" "$rows" | sort -t$'\t' -k1,1gr | awk -F'\t' 'NF>=7{printf "model:%s\t%s\t%s\t%.0f\t%.0f\t%.0f\n",$2,$3,$4,$5,$6,$7}'
    printf "%b" "$rows_other" | awk -F'\t' 'NF>=3{printf "model:%s\t%s\t%s\t-\t-\t-\n",$1,$2,$3}';;
  table)
    echo "Bolsa compartida del plan $PLAN_NAME (límites: $LIM_SRC)"
    printf "%-28s %8s %10s\n" "ventana" "usado" "USD"
    printf "%-28s %7.0f%% %10s %s\n" "5h (20% del mes)"            "$P5"  "\$$U5"  "$(bar "${P5%.*}")"
    printf "%-28s %7.0f%% %10s %s\n" "semana (desde lun 00 UTC)"   "$P7"  "\$$U7"  "$(bar "${P7%.*}")"
    printf "%-28s %7.0f%% %10s %s\n" "mes ($MONTH_LABEL)"          "$P30" "\$$U30" "$(bar "${P30%.*}")"
    if [ -n "$rows$rows_other" ]; then
      echo
      echo "Qué aporta cada modelo (puntos porcentuales de cada ventana; 1 USD pesa 100/límite):"
      printf "%-30s %10s %7s %7s %7s %7s\n" "modelo" "gasto mes" "límite" "mes" "semana" "5h"
      printf "%b" "$rows" | sort -t$'\t' -k1,1gr | while IFS=$'\t' read -r _ mid g l p30 p7 p5; do
        [ -n "${mid:-}" ] || continue
        printf "%-30s %10s %7s %6.1f%% %6.1f%% %6.1f%%\n" "$mid" "\$$(printf '%.4f' "$g")" "\$$l" "$p30" "$p7" "$p5"
      done
      printf "%b" "$rows_other" | while IFS=$'\t' read -r mid g l; do
        [ -n "${mid:-}" ] || continue
        printf "%-30s %10s %7s\n" "$mid" "\$$(printf '%.4f' "$g")" "$l"
      done
    fi
    if [ -n "$WANT_MODEL" ]; then
      wl="$(limit_of "$WANT_MODEL")"
      echo
      case "$wl" in
        "") echo "$WANT_MODEL: sin límite conocido (¿id correcto?)";;
        0)  echo "$WANT_MODEL: gratuito, no gasta de la bolsa";;
        *)  echo "$WANT_MODEL: límite \$$wl ⇒ 1 USD gasta $(awk -v l="$wl" 'BEGIN{printf "%.1f", 100/l}')% del mes," \
                 "$(awk -v l="$wl" 'BEGIN{printf "%.1f", 200/l}')% de la semana y $(awk -v l="$wl" 'BEGIN{printf "%.1f", 500/l}')% de la ventana de 5h";;
      esac
    fi
    echo
    echo "Ojo: un job cortado por plazo (status 124/137) se cobra pero opencode no registra su costo;"
    echo "  si hubo timeouts en modelos caros, el gasto real es mayor que el de esta tabla."
    [ -n "$sin_limite" ] && echo "Sin límite conocido (no suman a la bolsa; el consumo real es mayor): ${sin_limite}."
    if [ -n "$vetado_con_gasto" ]; then
      echo "OJO — modelo VETADO con gasto en el mes: ${vetado_con_gasto}."
      echo "  Algo se saltó el veto del helper (¿CHEAP_FANOUT_ALLOW_VETOED, u otra herramienta?)."
    fi
    case "$worst" in
      0) echo "holgado — el ancho puede ir a opencode-go";;
      1) echo "APRETADO — la bolsa está ≥80% en una ventana: cambiar de modelo de pago NO libera"
         echo "  presupuesto; manda el ancho a un gratuito sin entrenamiento (hy4-flash-free) o a codex";;
      2) echo "AGOTADO — la bolsa llegó a 100% en una ventana: ningún modelo de pago de Go responde."
         echo "  Usa un gratuito sin entrenamiento (hy4-flash-free) o codex hasta que se reinicie";;
    esac
    ;;
esac
exit "$worst"
